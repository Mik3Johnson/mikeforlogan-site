// Cloudflare settings for mikeforlogan.com (static site served by Workers).
// The mikeforlogan.com custom domain is attached in the Cloudflare dashboard
// (Worker > Settings > Domains & Routes) once the domain is active on Cloudflare.
{
  "name": "mikeforlogan-site",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
